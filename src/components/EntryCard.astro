---
import Icon from './Icon.astro';
import StackChips from './StackChips.astro';
import PSI from './PSI.astro';
import OrgLogo from './OrgLogo.astro';

/**
 * One role or project, told as Problem -> Solution -> Improvement.
 * Used for both so experience and projects read in the same voice.
 */
interface Props {
  title: string;
  subtitle: string;
  /** Link on the subtitle (an employer's site). */
  subtitleHref?: string;
  start: string;
  end: string;
  current?: boolean;
  stack: readonly string[];
  segments: readonly {
    label?: string;
    problem: string;
    solution: string;
    improvement?: string;
    metrics?: readonly { value: string; label: string; direction: 'up' | 'down' | 'flat' }[];
  }[];
  /** Logo slug + monogram fallback. Omit to render without a logo column. */
  logoSlug?: string;
  mark?: string;
  /** Live demos, writeups, repos. Nothing renders when the list is empty. */
  links?: readonly { label: string; url: string }[];
}

const {
  title,
  subtitle,
  subtitleHref,
  start,
  end,
  current = false,
  stack,
  segments,
  logoSlug,
  mark,
  links = [],
} = Astro.props;
---

<article
  class="rounded-lg border border-line bg-surface p-5 transition-colors hover:border-accent-bright/40 sm:p-6"
>
  <div class="flex gap-4">
    {logoSlug && mark && <OrgLogo slug={logoSlug} name={subtitle} mark={mark} />}

    <div class="min-w-0 flex-1">
      <header>
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h3 class="text-lg font-semibold sm:text-xl">{title}</h3>
          <span class="shrink-0 font-mono text-[0.68rem] text-faint">
            {start} &ndash; {end}
            {
              current && (
                <span class="ml-1.5 rounded-full bg-accent-soft px-1.5 py-0.5 text-accent">
                  current
                </span>
              )
            }
          </span>
        </div>

        <p class="mt-0.5 text-sm text-muted">
          {
            subtitleHref ? (
              <a
                href={subtitleHref}
                rel="noopener"
                class="inline-flex items-center gap-1 text-muted hover:text-accent"
              >
                {subtitle}
                <Icon name="external" size={12} />
              </a>
            ) : (
              subtitle
            )
          }
        </p>
        {
          links.length > 0 && (
            <p class="mt-2.5 flex flex-wrap gap-2">
              {links.map((link) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-center gap-1.5 rounded-md border border-accent-bright/40 bg-accent-soft px-2.5 py-1 text-[0.78rem] font-medium text-accent no-underline transition-colors hover:border-accent-bright hover:no-underline"
                >
                  {link.label}
                  <Icon name="external" size={12} />
                </a>
              ))}
            </p>
          )
        }
      </header>

      <StackChips items={stack} class="mt-3 mb-4" />

      <PSI segments={segments} />
    </div>
  </div>
</article>
