---
interface Props {
  items: readonly string[];
  class?: string;
}
const { items, class: className = '' } = Astro.props;
---

<ul class:list={['flex flex-wrap gap-1.5', className]}>
  {
    items.map((item) => (
      <li class="rounded-full border border-line bg-surface-2 px-2.5 py-0.5 font-mono text-[0.68rem] text-muted">
        {item}
      </li>
    ))
  }
</ul>
