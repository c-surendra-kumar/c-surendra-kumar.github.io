---
import { SITE } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-line">
  <div
    class="mx-auto flex w-full max-w-[100rem] flex-col gap-2 px-4 py-8 text-sm text-faint sm:flex-row sm:items-center sm:justify-between sm:px-6"
  >
    <p>&copy; {year} {SITE.name}</p>
    <p class="flex flex-wrap items-center gap-x-4 gap-y-1">
      <a class="text-faint hover:text-accent" href={`mailto:${SITE.email}`}>Email</a>
      <a class="text-faint hover:text-accent" href={SITE.github} rel="me noopener">GitHub</a>
      <a class="text-faint hover:text-accent" href={SITE.linkedin} rel="me noopener">LinkedIn</a>
    </p>
  </div>
</footer>
