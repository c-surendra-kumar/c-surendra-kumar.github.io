---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Page not found" description="That page does not exist.">
  <div class="py-24 text-center sm:py-32">
    <p
      class="mb-3 font-mono text-[0.68rem] uppercase tracking-[0.14em] text-accent-bright"
    >
      404
    </p>
    <h1 class="text-2xl font-bold sm:text-3xl">That page does not exist</h1>
    <p class="mx-auto mt-3 max-w-md text-sm text-muted">
      The link may be out of date. Everything on this site is reachable from the
      home page.
    </p>
    <a
      href="/"
      class="mt-7 inline-flex items-center gap-1.5 rounded-md border border-line px-4 py-2 text-sm font-medium text-ink no-underline transition-colors hover:border-accent-bright hover:bg-accent-soft hover:text-accent hover:no-underline"
    >
      <Icon name="arrow-left" size={14} />
      Back home
    </a>
  </div>
</Base>
