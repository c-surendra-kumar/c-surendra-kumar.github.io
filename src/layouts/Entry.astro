---
import Base from './Base.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description: string;
  /** Small line under the title: dates, venue, tags. */
  meta?: string;
  backHref: string;
  backLabel: string;
}

const { title, description, meta, backHref, backLabel } = Astro.props;
---

<Base title={title} description={description} ogType="article">
  <article class="py-10 sm:py-14">
    <a
      href={backHref}
      class="mb-7 inline-flex items-center gap-1.5 text-sm text-muted no-underline hover:text-accent hover:no-underline"
    >
      <Icon name="arrow-left" size={14} />
      {backLabel}
    </a>

    <header class="border-b border-line pb-5">
      <h1 class="text-2xl font-bold sm:text-3xl">{title}</h1>
      {meta && <p class="mt-2 font-mono text-[0.72rem] text-faint">{meta}</p>}
    </header>

    <slot name="aside" />

    <div class="prose mt-7">
      <slot />
    </div>
  </article>
</Base>
