---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Page-specific OG type; defaults to website. */
  ogType?: 'website' | 'article';
  /** Two-column shell: profile rail on the left, content on the right. */
  withSidebar?: boolean;
}

const {
  title,
  description = SITE.description,
  ogType = 'website',
  withSidebar = false,
} = Astro.props;

const pageTitle = title ? `${title} - ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  jobTitle: 'Graduate Research Assistant',
  description: SITE.description,
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'University of Maryland, College Park' },
    { '@type': 'CollegeOrUniversity', name: 'College of Engineering, Guindy (Anna University)' },
  ],
  knowsAbout: [
    'Agentic AI',
    'Retrieval-Augmented Generation',
    'Natural Language Processing',
    'Machine Learning Engineering',
  ],
  sameAs: [SITE.github, SITE.linkedin],
};
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* SVG first for browsers that take it; the PNG is the fallback for the
        ones that do not, and the touch icon is what iOS puts on a home screen.
        All three are generated from the same glyph by scripts/make_favicon.py. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f7f4ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#17150f" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <script is:inline set:html={JSON.stringify(personSchema)} type="application/ld+json" />

    {/* Set the theme before first paint so there is no flash of the wrong one. */}
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const theme =
          stored ??
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>

  <body class="min-h-dvh bg-bg text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:border focus:border-line focus:bg-surface focus:px-3 focus:py-2 focus:text-sm focus:text-ink"
    >
      Skip to content
    </a>

    <Nav />

    {
      withSidebar ? (
        <div class="mx-auto grid w-full max-w-[100rem] gap-x-10 px-4 pt-8 sm:px-6 lg:grid-cols-[17rem_minmax(0,1fr)] lg:pt-0">
          <Sidebar />
          <main id="main" class="min-w-0">
            <slot />
          </main>
        </div>
      ) : (
        <main id="main" class="mx-auto w-full max-w-[100rem] px-4 sm:px-6">
          <slot />
        </main>
      )
    }

    <Footer />
  </body>
</html>
